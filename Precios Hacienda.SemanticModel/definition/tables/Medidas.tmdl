	/// Motor generico: promedio de precio segun el producto seleccionado en la tabla Productos, aplicando fuente/categorias de Bridge_ProductoCategoria y coeficiente/operacion de Productos.
	measure 'Precio Base (Generico)' =
			VAR _nombre = SELECTEDVALUE('Productos'[NombreProducto])
			VAR _tipo = SELECTEDVALUE('Productos'[Tipo])
			VAR _fuente =
			    CALCULATE(
			        SELECTEDVALUE('Bridge_ProductoCategoria'[Fuente]),
			        'Bridge_ProductoCategoria'[NombreProducto] = _nombre,
			        'Bridge_ProductoCategoria'[Tipo] = _tipo
			    )
			VAR _moneda =
			    CALCULATE(
			        SELECTEDVALUE('Bridge_ProductoCategoria'[Moneda]),
			        'Bridge_ProductoCategoria'[NombreProducto] = _nombre,
			        'Bridge_ProductoCategoria'[Tipo] = _tipo
			    )
			VAR _categorias =
			    CALCULATETABLE(
			        VALUES('Bridge_ProductoCategoria'[Categoria]),
			        'Bridge_ProductoCategoria'[NombreProducto] = _nombre,
			        'Bridge_ProductoCategoria'[Tipo] = _tipo
			    )
			VAR _promedioCrudo =
			    CALCULATE(
			        AVERAGE(vw_precio_hacienda[precio]),
			        vw_precio_hacienda[fuente] = _fuente,
			        TREATAS(_categorias, vw_precio_hacienda[categoria]),
			        vw_precio_hacienda[moneda] = _moneda || ISBLANK(_moneda)
			    )
			VAR _coef =
			    CALCULATE(
			        SELECTEDVALUE('Productos'[Coeficiente]),
			        'Productos'[NombreProducto] = _nombre,
			        'Productos'[Tipo] = _tipo
			    )
			VAR _operacion =
			    CALCULATE(
			        SELECTEDVALUE('Productos'[Operacion]),
			        'Productos'[NombreProducto] = _nombre,
			        'Productos'[Tipo] = _tipo
			    )
			RETURN
			    IF(
			        OR(ISBLANK(_nombre), ISBLANK(_tipo)),
			        BLANK(),
			        SWITCH(
			            _operacion,
			            "Multiplica", _promedioCrudo * _coef,
			            "Divide", DIVIDE(_promedioCrudo, _coef),
			            _promedioCrudo
			        )
			    )
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 0e5d4d03-7451-4ca4-a30f-d239e7adae17

