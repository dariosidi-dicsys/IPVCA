			measure Produccion_Año_Anterior =
					
					CALCULATE(
					    [Produccion_Final_Suma],
					    SAMEPERIODLASTYEAR('Calendario'[Date])
					)
				lineageTag: ec1a1897-a573-46e1-9e81-71c44f1531e0

