	/// Valor de Egresos / Novillo / Categoria Animal correspondiente al mes calendario anterior al ultimo dato disponible.
	measure 'Valor 1 mes anterior Novillo Egresos' =
			VAR UltimaFecha = [_Fecha Novillo Egresos]
			VAR FechaRef = EDATE(UltimaFecha, -1)
			VAR AnioRef = YEAR(FechaRef)
			VAR MesRef = MONTH(FechaRef)
			VAR PrimerDiaMesRef = DATE(AnioRef, MesRef, 1)
			VAR UltimoDiaMesRef = EOMONTH(PrimerDiaMesRef, 0)
			VAR UltimaFechaRef =
			    CALCULATE(
			        MAX(vw_engorde_corral[fecha]),
			        REMOVEFILTERS(vw_engorde_corral[fuente]),
			        REMOVEFILTERS(vw_engorde_corral[categoria]),
			        REMOVEFILTERS(vw_engorde_corral[tipo]),
			        ALL(vw_engorde_corral[fecha]),
			        ALL(vw_engorde_corral[anio]),
			        REMOVEFILTERS('Calendario'),
			        vw_engorde_corral[fuente] = "Egresos",
			        vw_engorde_corral[categoria] = "Novillo",
			        vw_engorde_corral[tipo] = "Categoria Animal",
			        vw_engorde_corral[fecha] >= PrimerDiaMesRef,
			        vw_engorde_corral[fecha] <= UltimoDiaMesRef
			    )
			RETURN
			    CALCULATE(
			        AVERAGE(vw_engorde_corral[valor]),
			        REMOVEFILTERS(vw_engorde_corral[fuente]),
			        REMOVEFILTERS(vw_engorde_corral[categoria]),
			        REMOVEFILTERS(vw_engorde_corral[tipo]),
			        ALL(vw_engorde_corral[fecha]),
			        ALL(vw_engorde_corral[anio]),
			        REMOVEFILTERS('Calendario'),
			        vw_engorde_corral[fuente] = "Egresos",
			        vw_engorde_corral[categoria] = "Novillo",
			        vw_engorde_corral[tipo] = "Categoria Animal",
			        vw_engorde_corral[fecha] = UltimaFechaRef
			    )
		formatString: #,##0.00
		displayFolder: Egresos - Categoria Animal
		lineageTag: 966a115e-7346-43e3-bb86-72a6d4e03098

	measure Valor_Ingresos =
			
			CALCULATE(
			    SUM(vw_engorde_corral[valor]),
			    vw_engorde_corral[tipo] = "Composición",
			    vw_engorde_corral[categoria] = "Ingresos"
			)
		formatString: 0
		lineageTag: cb220cd2-3aff-4f0e-972c-d3d0abfedc9d

	measure Valor_Egresos =
			
			CALCULATE(
			    SUM(vw_engorde_corral[valor]),
			    vw_engorde_corral[tipo] = "Composición",
			    vw_engorde_corral[categoria] = "Egresos"
			)
		formatString: 0
		lineageTag: 79f8f66c-e785-4074-ba56-91f58e0b9631

	measure Indice_Reposicion =
			
			DIVIDE(
			    [Valor_Ingresos],
			    [Valor_Egresos]
			)
		lineageTag: 0ceab34b-97de-4bc9-8d8c-1c1c742b6c10

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Valor_Con_Indice = ```
			
			SWITCH(
			    TRUE(),
			    -- Si la categoría actual en la fila es "Ingresos"
			    SELECTEDVALUE(vw_engorde_corral[categoria]) = "Ingresos", [Valor_Ingresos],
			    
			    -- Si la categoría actual en la fila es "Egresos"
			    SELECTEDVALUE(vw_engorde_corral[categoria]) = "Egresos", [Valor_Egresos],
			    
			    -- Si la fila es el "Índice" (calculado al nivel general de la matriz de filas)
			    ISBLANK(SELECTEDVALUE(vw_engorde_corral[categoria])), [Indice_Reposicion],
			    
			    -- Por defecto, la suma normal para los niveles superiores (meses, años)
			    CALCULATE(
			        SUM(vw_engorde_corral[valor]),
			        vw_engorde_corral[tipo] = "Composición"
			    )
			)
			```
		lineageTag: 5ada4a02-9782-4cad-8c28-9dbef2851378

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Valor_Matriz_Con_Indice = ```
			
			VAR _CategoriaActual = SELECTEDVALUE(vw_engorde_corral[categoria])
			RETURN
			SWITCH(
			    TRUE(),
			    -- Si es la fila de Egresos
			    _CategoriaActual = "Egresos", [Valor_Egresos],
			    
			    -- Si es la fila de Ingresos
			    _CategoriaActual = "Ingresos", [Valor_Ingresos],
			    
			    -- Si estamos en el nivel del mes (cuando la categoría está en blanco en el total del grupo)
			    -- Aquí forzamos el cálculo del índice para que actúe como una tercera fila de cierre
			    ISBLANK(_CategoriaActual), [Indice_Reposicion],
			    
			    BLANK()
			)
			```
		lineageTag: 6e2667c2-b4e7-465c-92df-20181537f184

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Valor del mes calendario anterior al mes filtrado (via slicers de Año/Semestre/Mes sobre la tabla Calendario).
	measure 'Valor Mes Anterior' =
			VAR FechaMax = MAX ( Calendario[Date] )
			VAR FechaRef = EDATE ( FechaMax, -1 )
			VAR AnioRef = YEAR ( FechaRef )
			VAR MesRef = MONTH ( FechaRef )
			RETURN
			    CALCULATE (
			        [Valor],
			        REMOVEFILTERS ( Calendario ),
			        Calendario[Año] = AnioRef,
			        Calendario[MesNumero] = MesRef
			    )
		formatString: #,##0
		displayFolder: Existencia
		lineageTag: 6bd3fbbf-318e-4c88-8bc2-a10aa7f96a8e

