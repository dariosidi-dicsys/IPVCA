			measure Produccion_Denticion_Categoria_ver = ```
					
					VAR _totalCabezasCategoria =
					    CALCULATE(
					        [Total Cabezas],
					        ALLSELECTED('public faena'[dentición])
					    )
					
					VAR _pesoPromedioPonderado =
					    DIVIDE(
					        CALCULATE(
					            SUMX(
					                VALUES('public faena'[dentición]),
					                VAR _cabezas = CALCULATE([Total Cabezas])
					                VAR _peso = CALCULATE(AVERAGE('public faena'[peso_res]))
					                RETURN _cabezas * _peso
					            ),
					            ALLSELECTED('public faena'[dentición])
					        ),
					        _totalCabezasCategoria
					    )
					
					VAR _resultado = 
					    DIVIDE(
					        _totalCabezasCategoria * _pesoPromedioPonderado,
					        1000
					    )
					
					RETURN
					    _resultado
					```
