	/// Promedio del precio base entre todos los productos visibles en el contexto actual (ej: todos los del Tipo filtrado en la página). Usa la medida Precio Base (Generico) por producto y promedia, ignorando blancos.
	measure 'Precio Base (Generico) Promedio' =
			AVERAGEX(
			    VALUES('Productos'[NombreProducto]),
			    [Precio Base (Generico)]
			)
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: d6fbdfbc-a639-4ee0-adc3-0617000eb012

