		displayFolder: Motor Generico
		lineageTag: 3acb103c-3e7b-45be-8ee5-f7b0ea3924aa

	/// Variacion % de Q1 (quincena anterior) contra Q2 (dos quincenas atras)
	measure 'Precio Base Var % Q1 Q2' = DIVIDE([Precio Base Q1 Anterior] - [Precio Base Q2 Anterior], [Precio Base Q2 Anterior])
		formatString: 0.00%
		displayFolder: Motor Generico
		lineageTag: 516961ec-3c6f-4c78-a69e-f344a1f6f201

	measure 'Precio Base Var % Q1 Q2 Promedio' = DIVIDE([Precio Base Q1 Anterior Promedio] - [Precio Base Q2 Anterior Promedio], [Precio Base Q2 Anterior Promedio])
		formatString: 0.00%
		displayFolder: Motor Generico
		lineageTag: b90916df-8ebf-4acc-98cc-2cc8b24504d8

	/// Diferencia entre el precio actual y Q2 (30 dias antes)
	measure 'Precio Base Diferencia Q2' = [Precio Base (Generico)] - [Precio Base Q2 Anterior]
