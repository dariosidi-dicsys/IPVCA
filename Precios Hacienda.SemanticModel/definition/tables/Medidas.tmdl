		lineageTag: 5267925c-627b-4cbb-acbe-8c78eee0a545

	/// Precio del motor generico 15 dias antes (quincena anterior)
	measure 'Precio Base Q1 Anterior' = CALCULATE([Precio Base (Generico)], DATEADD('Calendario'[Date], -15, DAY))
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: e8921c1f-fac0-45fb-aeae-f95e7b533fc7

	/// Variacion % del motor generico contra la quincena anterior (15 dias)
	measure 'Precio Base Var % Q1' = DIVIDE([Precio Base (Generico)] - [Precio Base Q1 Anterior], [Precio Base Q1 Anterior])
		formatString: 0.00%
		displayFolder: Motor Generico
		lineageTag: 34352ac2-91fd-4b28-afb7-6d32b61c8354

