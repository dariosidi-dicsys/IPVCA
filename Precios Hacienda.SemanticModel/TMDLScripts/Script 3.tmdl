			partition Calendario = calculated
				mode: import
				source =
						ADDCOLUMNS(
						    CALENDAR(
						        MIN('Precios_internacionales'[Fecha]),
						        MAX('Precios_internacionales'[Fecha])
						    ),
						    "Año", YEAR([Date]),
						    "MesNumero", MONTH([Date]),
						    "NombreMes", FORMAT([Date], "MMMM"),
						    "AnioMes", YEAR([Date]) * 100 + MONTH([Date]),
						    "Trimestre", "T" & FORMAT([Date], "Q"),
						    "Semestre", IF(MONTH([Date]) <= 6, "S1", "S2"),
						    "NroSemana", WEEKNUM([Date], 2),
						    "AnioSemana", YEAR([Date]) * 100 + WEEKNUM([Date], 2),
						    "MesAnio", FORMAT([Date], "MMM-YYYY")
						)

		table Medidas
