		displayFolder: Motor Generico
		lineageTag: 4225ed09-5a52-4249-b08b-a02b1391f70f

	/// Precio del motor generico 30 dias antes (quincena anterior a Q1)
	measure 'Precio Base Q2 Anterior' = CALCULATE([Precio Base (Generico)], DATEADD('Calendario'[Date], -30, DAY))
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 8d0519a2-d1e4-43a0-ac50-f3a9d00d58d8

