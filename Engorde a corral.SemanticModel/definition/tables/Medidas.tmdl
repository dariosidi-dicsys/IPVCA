	measure 'Valor Composicion' = ```
			
			IF(
			    -- Si la categoría está en el contexto (es decir, el usuario desplegó el mes para ver el detalle)
			    ISINSCOPE('vw_engorde_corral'[categoria]),
			    
			    -- Entonces muestra la suma normal de los valores absolutos
			    SUM('vw_engorde_corral'[valor]),
			    
			    -- Si el mes está colapsado, devuelve blanco para evitar sumar Ingresos + Egresos
			    BLANK()
			)
			```
		formatString: #,0
