			measure Produccion_mes_anterior = ```
					
					CALCULATE (
					    [Produccion_Denticion_Categoria],
					    DATEADD ( Calendario[Date], -1, MONTH ),
					    REMOVEFILTERS ( Calendario[Año] )
					)
					
					```
				formatString: 0
				lineageTag: c231d12b-e745-4e61-87ef-382dc5a2be53

			measure Produccion_ultimo_periodo =
					
					[Total Cabezas] * [Total Peso Res]
					/*var max_fecha= MAX('public faena'[anio_mes])
					RETURN
					CALCULATE(SUM('public faena'[cantidad_cabezas]),FILTER('public faena','public faena'[anio_mes]=max_fecha))*/
				formatString: 0
				lineageTag: 60974f50-ec4f-4f6f-b300-2f52ca13a5eb

			measure Produccion_Denticion_Categoria =
					
					VAR _totalCabezasCategoria =
					    CALCULATE(
					        [Total Cabezas],
					        ALLSELECTED('public faena'[dentición])
					    )
					VAR _pesoPromedioPonderado =
					    DIVIDE(
					        SUMX(
					            VALUES('public faena'[dentición]),
					            [Total Cabezas] * CALCULATE(MAX('public faena'[peso_res]))
					        ),
					        [Total Cabezas]
					    )
					VAR _resultado = DIVIDE(_totalCabezasCategoria * _pesoPromedioPonderado, 1000)
					RETURN
					    _resultado
				lineageTag: 2f9b6a90-e534-449f-9832-d9fc50a35815

				annotation PBI_FormatHint = {"isGeneralNumber":true}

