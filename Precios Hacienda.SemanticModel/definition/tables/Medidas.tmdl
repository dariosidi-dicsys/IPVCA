table Medidas
	lineageTag: f4cf3e11-e925-48f1-95fd-13eb3056c30f

	measure Ultima_Fecha_Datos = ```
			
			VAR _maxFecha = 
			    CALCULATE(
			        MAX('vw_precio_hacienda'[fecha]),
			        REMOVEFILTERS('vw_precio_hacienda'),
			        REMOVEFILTERS('Calendario')
			    )
			VAR _mes = FORMAT(_maxFecha, "mmmm")
			VAR _anio = FORMAT(_maxFecha, "yyyy")
			
			-- Tomamos la primera letra, la pasamos a Mayúscula y pegamos el resto
			RETURN
			    UPPER(LEFT(_mes, 1)) & RIGHT(_mes, LEN(_mes) - 1) & " " & _anio
			```
		lineageTag: 23db5140-c4f8-4b7a-b31b-c7d565904b3b

	/// Promedio mensual de precio Novillo Exportación (fuente CCDH, categorías M/C 440-460, 460-490, 490+ y Overo Negro), expresado en gancho (valor base sin ajuste).
	measure 'Novillo Exp Gancho' =
			CALCULATE(
			    AVERAGE(vw_precio_hacienda[precio]),
			    vw_precio_hacienda[fuente] = "CCDH",
			    vw_precio_hacienda[categoria] IN {
			        "M 440-460", "M 460-490", "M 490+",
			        "C 440-460", "C 460-490", "C 490+",
			        "Overo Negro"
			    }
			)
		formatString: #,##0.00
		displayFolder: Novillo Exp
		lineageTag: 110b1e93-2622-4877-8816-75a7afbabb78

	/// Precio Novillo Exportación expresado en pie: resultado de Novillo Exp Gancho multiplicado por el coeficiente 0,585 (rendimiento gancho->pie).
	measure 'Novillo Exp Pie' = [Novillo Exp Gancho] * 0.585
		formatString: #,##0.00
		displayFolder: Novillo Exp
		lineageTag: 8cd8d6dd-9f14-40f8-9420-a26eabac21c5

	/// Promedio mensual de precio Ternero AA, fuente CCDH, categoría Ternero Mestizo INVERNADA (160-180 kg). El valor de la fuente ya está expresado en pie, no se aplica coeficiente.
