	/// Precio del motor generico en la primera quincena (Q1) del mes calendario anterior. Replica el patron de 'Promedio Q1 Mes Anterior' de Precios Nacionales (misma quincena, mes calendario anterior via Calendario[Quincena]), distinto del offset fijo -15 dias de 'Precio Base Q1 Anterior'.
	measure 'Precio Base Q1 Mes Anterior' = CALCULATE([Precio Base (Generico)], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q1")
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: c7e5d334-107e-4b2a-b249-8352923ec747

	/// Precio del motor generico en la segunda quincena (Q2) del mes calendario anterior. Replica el patron de 'Promedio Q2 Mes Anterior' de Precios Nacionales, distinto del offset fijo -30 dias de 'Precio Base Q2 Anterior'.
	measure 'Precio Base Q2 Mes Anterior' = CALCULATE([Precio Base (Generico)], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q2")
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 32a4d7a6-0697-4651-94fb-770e8f1542cd

	/// Version promediada (todos los productos visibles) de Precio Base Q1 Mes Anterior.
	measure 'Precio Base Q1 Mes Anterior Promedio' = CALCULATE([Precio Base (Generico) Promedio], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q1")
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 562f2ad4-a840-43cc-9017-7bf7bb9b0c15

	/// Version promediada (todos los productos visibles) de Precio Base Q2 Mes Anterior.
	measure 'Precio Base Q2 Mes Anterior Promedio' = CALCULATE([Precio Base (Generico) Promedio], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q2")
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 6bca09c9-ae18-480c-8d2c-7ebd8839cbe7

	/// Comparativo generico de la quincena cronologicamente anterior: si el contexto actual es Q2, compara contra Q1 del MISMO mes; si es Q1, compara contra Q2 del mes calendario anterior. Replica exactamente 'Precio Promedio Quincena Anterior' de Precios Nacionales.
	measure 'Precio Base Quincena Anterior' =
			IF(
			    SELECTEDVALUE('Calendario'[Quincena]) = "Q2",
			    CALCULATE([Precio Base (Generico)], 'Calendario'[Quincena] = "Q1"),
			    CALCULATE([Precio Base (Generico)], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q2")
			)
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: d536ff72-f3c0-4ec6-b535-f7e545cd61cc

	/// Version promediada (todos los productos visibles) de Precio Base Quincena Anterior.
	measure 'Precio Base Quincena Anterior Promedio' =
			IF(
			    SELECTEDVALUE('Calendario'[Quincena]) = "Q2",
			    CALCULATE([Precio Base (Generico) Promedio], 'Calendario'[Quincena] = "Q1"),
			    CALCULATE([Precio Base (Generico) Promedio], DATEADD('Calendario'[Date], -1, MONTH), 'Calendario'[Quincena] = "Q2")
			)
		formatString: #,##0.00
		displayFolder: Motor Generico
		lineageTag: 7d0a3d8d-91e3-4287-8463-2ab013b1b107

