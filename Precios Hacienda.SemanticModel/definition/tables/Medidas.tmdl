		displayFolder: Motor Generico
		lineageTag: a5e0c6c3-f2c0-4497-b1cc-83b417105abd

	/// Diferencia entre Q1 (quincena anterior, -15d) y Q2 (-30d)
	measure 'Precio Base Diferencia Q1 Q2' = [Precio Base Q1 Anterior] - [Precio Base Q2 Anterior]
		formatString: #,##0.00;-#,##0.00
		displayFolder: Motor Generico
