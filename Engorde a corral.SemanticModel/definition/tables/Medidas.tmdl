	measure Indice = ```
			
			IF(
			    -- Si la categoría NO está en el contexto actual (es decir, nivel mes o total)
			    NOT ISINSCOPE('vw_engorde_corral'[categoria]),
			    
			    VAR TotalIngresos = 
			        CALCULATE(
			            SUM('vw_engorde_corral'[valor]),
			            'vw_engorde_corral'[fuente] = "Composición Feedlot",
			            'vw_engorde_corral'[categoria] = "Ingresos",
			            REMOVEFILTERS('vw_engorde_corral'[categoria])
			        )
			    VAR TotalEgresos = 
			        CALCULATE(
			            SUM('vw_engorde_corral'[valor]),
			            'vw_engorde_corral'[fuente] = "Composición Feedlot",
			            'vw_engorde_corral'[categoria] = "Egresos",
			            REMOVEFILTERS('vw_engorde_corral'[categoria])
			        )
			    RETURN
			        DIVIDE(TotalIngresos, TotalEgresos),
			        
			    -- Si la categoría está expandida (filas de Ingresos/Egresos), devuelve BLANCO
			    BLANK()
			)
			```
		lineageTag: aee75512-249a-4f6c-8493-aaf89807367a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Indice Mes Anterior' =
			
