table Medidas
	lineageTag: f4cf3e11-e925-48f1-95fd-13eb3056c30f

	measure Ultima_Fecha_Datos = ```
			
			VAR _maxFecha = 
			    CALCULATE(
			        MAX('vw_engorde_corral'[fecha]),
			        REMOVEFILTERS('vw_engorde_corral'),
			        REMOVEFILTERS('Calendario')
			    )
			VAR _mes = FORMAT(_maxFecha, "mmmm")
			VAR _anio = FORMAT(_maxFecha, "yyyy")
			
			-- Tomamos la primera letra, la pasamos a Mayúscula y pegamos el resto
			RETURN
			    UPPER(LEFT(_mes, 1)) & RIGHT(_mes, LEN(_mes) - 1) & " " & _anio
			```
		lineageTag: 23db5140-c4f8-4b7a-b31b-c7d565904b3b

	/// [Auxiliar] Ultima fecha con dato: Egresos / Novillo / Categoria Animal.
	measure '_Fecha Novillo Egresos' =
			
			CALCULATE(
			    MAX(vw_engorde_corral[fecha]),
			    REMOVEFILTERS(vw_engorde_corral[fuente]),
			    REMOVEFILTERS(vw_engorde_corral[categoria]),
			    REMOVEFILTERS(vw_engorde_corral[tipo]),
			    vw_engorde_corral[fuente] = "Egresos",
			        vw_engorde_corral[categoria] = "Novillo",
			        vw_engorde_corral[tipo] = "Categoria Animal"
			)
		formatString: dd/mm/yyyy
		isHidden
		displayFolder: Egresos - Categoria Animal\_Auxiliares
		lineageTag: d29e51f0-9c01-4929-a604-018092a5e587

	/// Ultimo valor disponible: Egresos / Novillo / Categoria Animal.
	measure 'Valor Novillo Egresos' =
			VAR FechaMax = [_Fecha Novillo Egresos]
			RETURN
			CALCULATE(
			    AVERAGE(vw_engorde_corral[valor]),
			    REMOVEFILTERS(vw_engorde_corral[fuente]),
			    REMOVEFILTERS(vw_engorde_corral[categoria]),
			    REMOVEFILTERS(vw_engorde_corral[tipo]),
			    vw_engorde_corral[fuente] = "Egresos",
			    vw_engorde_corral[categoria] = "Novillo",
			    vw_engorde_corral[tipo] = "Categoria Animal",
			    vw_engorde_corral[fecha] = FechaMax
			)
		formatString: #,##0.00
		displayFolder: Egresos - Categoria Animal
		lineageTag: 107aea9b-5a9b-4107-9013-d8927e3849ce

	/// Diferencia mensual de Egresos / Novillo (Categoria Animal).
	measure 'Diferencia Mensual Novillo Egresos' =
			
			VAR UltimaFecha = [_Fecha Novillo Egresos]
			VAR FechaRef = EDATE(UltimaFecha, -1)
			VAR AnioRef = YEAR(FechaRef)
			VAR MesRef = MONTH(FechaRef)
			VAR PrimerDiaMesRef = DATE(AnioRef, MesRef, 1)
			VAR UltimoDiaMesRef = EOMONTH(PrimerDiaMesRef, 0)
			VAR UltimaFechaRef =
			    CALCULATE(
			        MAX(vw_engorde_corral[fecha]),
			        REMOVEFILTERS(vw_engorde_corral[fuente]),
			        REMOVEFILTERS(vw_engorde_corral[categoria]),
			        REMOVEFILTERS(vw_engorde_corral[tipo]),
			        ALL(vw_engorde_corral[fecha]),
			        ALL(vw_engorde_corral[anio]),
			        REMOVEFILTERS('Calendario'),
			        vw_engorde_corral[fuente] = "Egresos",
			        vw_engorde_corral[categoria] = "Novillo",
			        vw_engorde_corral[tipo] = "Categoria Animal",
			        vw_engorde_corral[fecha] >= PrimerDiaMesRef,
			        vw_engorde_corral[fecha] <= UltimoDiaMesRef
			    )
			VAR ValorRef =
			    CALCULATE(
			        AVERAGE(vw_engorde_corral[valor]),
			        REMOVEFILTERS(vw_engorde_corral[fuente]),
			        REMOVEFILTERS(vw_engorde_corral[categoria]),
			        REMOVEFILTERS(vw_engorde_corral[tipo]),
			        ALL(vw_engorde_corral[fecha]),
			        ALL(vw_engorde_corral[anio]),
			        REMOVEFILTERS('Calendario'),
			        vw_engorde_corral[fuente] = "Egresos",
			        vw_engorde_corral[categoria] = "Novillo",
			        vw_engorde_corral[tipo] = "Categoria Animal",
			        vw_engorde_corral[fecha] = UltimaFechaRef
			    )
			VAR ValorActual = [Valor Novillo Egresos]
			VAR Diferencia = ValorActual - ValorRef
			RETURN
			    IF(
			        ISBLANK(ValorRef) || ISBLANK(ValorActual),
			        BLANK(),
			        Diferencia
			    )
		formatString: #,##0.00
		displayFolder: Egresos - Categoria Animal
		lineageTag: 21a2574b-7309-4d9d-bc6d-e7c0b729edcf

