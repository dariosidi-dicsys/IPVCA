		sourceColumn: [AnioQuincena]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(vw_precio_hacienda[fecha]),
				        MAX(vw_precio_hacienda[fecha])
				    ),
				    "Año", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "NombreMes", SWITCH(
				        MONTH([Date]),
				        1, "Enero", 2, "Febrero", 3, "Marzo", 4, "Abril", 
				        5, "Mayo", 6, "Junio", 7, "Julio", 8, "Agosto", 
				        9, "Septiembre", 10, "Octubre", 11, "Noviembre", 12, "Diciembre"
				    ),
				    "NombreMesCorto", SWITCH(
				        MONTH([Date]),
				        1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 
				        5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 
				        9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic"
				    ),
				    "MesAnio", SWITCH(
				        MONTH([Date]),
				        1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 
				        5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 
				        9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic"
				    ) & "-" & YEAR([Date]),
				    "AnioMes", YEAR([Date]) * 100 + MONTH([Date]),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "NroTrimestre", INT((MONTH([Date]) + 2) / 3),
				    "AnioTrimestre", YEAR([Date]) * 10 + INT((MONTH([Date]) + 2) / 3),
				    "Semestre", IF(MONTH([Date]) <= 6, "S1", "S2"),
				    "NroSemana", WEEKNUM([Date], 2),
				    "AnioSemana", YEAR([Date]) * 100 + WEEKNUM([Date], 2),
				    "Dia", DAY([Date]),
				    "DiaSemana", SWITCH(
				        WEEKDAY([Date], 2),
				        1, "Lunes", 2, "Martes", 3, "Miércoles", 4, "Jueves", 
				        5, "Viernes", 6, "Sábado", 7, "Domingo"
				    ),
				    "NroDiaSemana", WEEKDAY([Date], 2),
				    "Quincena", IF(DAY([Date]) <= 15, "Q1", "Q2"),
				    "NroQuincena", IF(DAY([Date]) <= 15, 1, 2),
				    "AnioQuincena", (YEAR([Date]) * 100 + MONTH([Date])) * 10 + IF(DAY([Date]) <= 15, 1, 2)
				)
				```

